# Copy this file to deploy/.env and fill in real values.
# deploy/.env is gitignored and must never be committed.

# ─── PostgreSQL ──────────────────────────────────────────────────────
# Used by both the postgres container and OmniHub's DSN.
POSTGRES_USER=omnihub
POSTGRES_PASSWORD=replace_with_strong_random_password
POSTGRES_DB=omnihub

# ─── OmniHub virtual key auth (REQUIRED) ─────────────────────────────
# Comma-separated client keys. Optional "label:" prefix is surfaced in
# request logs so per-key usage is attributable.
#
# Examples:
#   OMNIHUB_API_KEYS=omni-secret-abc
#   OMNIHUB_API_KEYS=alice:omni-aaaa,bob:omni-bbbb,ci:omni-cccc
OMNIHUB_API_KEYS=alice:replace_with_random_key

# ─── Upstream credentials ────────────────────────────────────────────
# Set ONE of the two blocks. When both are set, Claude Platform on AWS
# takes precedence.

# (a) Direct Anthropic API — api.anthropic.com
OMNIHUB_ANTHROPIC_API_KEY=

# (b) Claude Platform on AWS — aws-external-anthropic.{region}.api.aws
OMNIHUB_CLAUDE_PLATFORM_API_KEY=
OMNIHUB_CLAUDE_PLATFORM_REGION=us-east-1
OMNIHUB_CLAUDE_PLATFORM_WORKSPACE_ID=

# ─── Trusted reverse proxies (optional, default none) ───────────────
# Comma-separated CIDR / IP / hostname list of proxies whose
# X-Forwarded-For header the gateway should believe. Set this ONLY
# to the LB / nginx in front of OmniHub; otherwise clients can spoof
# their IP. Use "*" to trust every proxy (dangerous).
#OMNIHUB_TRUSTED_PROXIES=10.0.0.0/8

# ─── Session stickiness (optional, default 5m) ──────────────────────
# Same conversation → same upstream account for this long, so
# Anthropic prompt-cache hits more often. Set to "0" or "off" to
# disable; cache hit rates will drop. Go duration syntax.
#OMNIHUB_SESSION_TTL=5m

# ─── Circuit breaker (optional, defaults shown) ──────────────────────
# Number of consecutive failures that trips an account into cooldown.
# Set to 0 to disable the circuit breaker entirely.
#OMNIHUB_CIRCUIT_FAILURE_THRESHOLD=5
# Cooldown duration before a tripped account is allowed a trial.
# Go duration syntax: "30s", "2m", "5m".
#OMNIHUB_CIRCUIT_OPEN_DURATION=30s
# Successes required in half-open state to fully close the circuit.
#OMNIHUB_CIRCUIT_HALF_OPEN_SUCCESS=1

# ─── Misc ────────────────────────────────────────────────────────────
# Container image tag to deploy.
OMNIHUB_VERSION=latest
# Host port to publish the gateway on.
OMNIHUB_PORT=8080
