{
  "compilerOptions": {
    "composite": true,
    // Config-only project: redirect the unavoidable composite emit into a
    // throwaway dir under node_modules (already gitignored) so `tsc -b`
    // doesn't drop vite.config.js / .d.ts into the working tree.
    "outDir": "./node_modules/.tmp",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}
